# Package

version       = "1.0.0"
author        = "Genzimnify"
description   = "Genzimnify: Python semantics, Gen Z surface syntax, transpiles .gzim to Python. If it vibes, it compiles."
license       = "MIT"
srcDir        = "src"
bin           = @["genzimc", "gzim-lsp"]
requires      = "nim >= 2.0.0"
